# Copy this file to config.env and fill in your values.
# config.env is ignored by git - never commit real credentials.

# Your WhatsApp number, digits only, international format.
# Used for pairing-code login (recommended on servers).
PAIRING_NUMBER=

# Optional: MEGA.nz file id containing a saved sessions/creds.json
SESSION_ID=

# Optional extra lock for the login QR / pairing code shown on the homepage.
# Leave empty and the QR is shown automatically while the bot waits to be
# linked (it disappears once connected). Set it, then open the site as
# /?token=YOUR_SECRET to see the QR again.
STATUS_TOKEN=

# Owner number for owner-only commands and private mode.
OWNER_NUMBER=

# Bot behaviour
PREFIX=.
MODE=private
BOT_NAME=System32 WB

# Optional extras used by some plugins
OWNER_NAME=
OWNER_EMAIL=
OWNER_GITHUB=
OWNER_LOCATION=
